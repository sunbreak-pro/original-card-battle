<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Engine-free seam of the trial app: life setup, names, journal intel, enemy pages, save data, JSON, the replay recorder, departure carry.
         The files live in the Unity kit under Assets/View/Trial/Bridge/ and are mirrored by `npm run unity:sync`;
         this project only lets `dotnet test` compile the same files. netstandard2.1 + C# 9 is what Unity compiles. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Trial.Bridge</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS4014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\unity-project-kit\Assets\View\Trial\Bridge\**\*.cs" LinkBase="Bridge" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trial.Async\Trial.Async.csproj" />
    <ProjectReference Include="..\BattleCore\BattleCore.csproj" />
    <ProjectReference Include="..\DungeonCore\DungeonCore.csproj" />
    <ProjectReference Include="..\DungeonContent\DungeonContent.csproj" />
    <ProjectReference Include="..\InheritanceCore\InheritanceCore.csproj" />
    <ProjectReference Include="..\Depiction.Script\Depiction.Script.csproj" />
    <ProjectReference Include="..\Depiction.Bridge\Depiction.Bridge.csproj" />
    <ProjectReference Include="..\Exploration.Script\Exploration.Script.csproj" />
    <ProjectReference Include="..\Exploration.Bridge\Exploration.Bridge.csproj" />
    <ProjectReference Include="..\Journal.Script\Journal.Script.csproj" />
    <ProjectReference Include="..\Backdrop.Script\Backdrop.Script.csproj" />
  </ItemGroup>

</Project>
