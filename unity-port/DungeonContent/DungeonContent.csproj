<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The catalogue of tools and consumables an explorer sets out with. Data only: no
         project reference, so it can be read by the exploration core, the battle core or a
         loadout screen without dragging any of them in behind it.
         netstandard2.1 + C# 9: what Unity 2021.2+ compiles as-is, same as the other cores. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
